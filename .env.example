# Copy to .env (`make setup` does this). .env is ignored by Git; keep credentials there only.
# Any service left unconfigured uses clearly labelled test responses.

# Video shown in the player: an http(s) URL or a local file path.
# data/demo.mp4 is a 6-minute test pattern with an on-screen clock, generated by `make setup`.
VIDEO_ID=demo
VIDEO_TITLE=Demo test pattern (generated by make setup)
VIDEO_URL=data/demo.mp4

# VAST/VSS: video search and clip retrieval. Leave VSS_BASE_URL empty for test responses.
VSS_BASE_URL=
VSS_API_KEY=
VSS_SEARCH_PATH=/search
VSS_CLIP_PATH=/clips

# YOLO object detection. Leave YOLO_BASE_URL empty for test responses.
YOLO_BASE_URL=
YOLO_API_KEY=
YOLO_DETECT_PATH=/detect
YOLO_MODEL=yolo

# Cosmos: clip analysis. Leave COSMOS_BASE_URL empty for test responses.
COSMOS_BASE_URL=
COSMOS_API_KEY=
COSMOS_ANALYZE_PATH=/analyze
COSMOS_MODEL=cosmos-reason

# W&B Inference: language model calls. Leave WANDB_API_KEY empty for test responses.
WANDB_API_KEY=
WANDB_BASE_URL=https://api.inference.wandb.ai/v1
# W&B "entity/project" sent as the OpenAI-Project header.
WANDB_PROJECT=
WANDB_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Background jobs
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_S=120
SERVICE_TIMEOUT_S=30
TEST_RESPONSE_DELAY_S=0.4

# SQLite cache of clip analyses (video, interval, model, prompt version)
CACHE_PATH=data/cache.sqlite3
